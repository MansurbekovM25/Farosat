// BOSHLANG'ICH QORALAMA - hali Firebase'ga ulanmagan va sinalmagan.
// 2-bosqichda Firebase Emulator'da sinaladi.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.role == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['displayName', 'parentContact']);
    }

    match /grades/{id}  { allow read: if true; allow write: if isAdmin(); }

    match /lessons/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Video manzillari faqat server (Cloud Functions) orqali o'qiladi.
    match /lessonSources/{id} { allow read, write: if false; }

    match /subscriptions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /news/{id} { allow read: if true; allow write: if isAdmin(); }

    match /threads/{uid}/messages/{m} {
      allow read, create: if signedIn() && request.auth.uid == uid;
    }
  }
}
